# Server-only. Never expose these as PUBLIC_ variables or commit a populated .env file.
# The sync auto-discovers every channel this token's account owns — no channel list to set here.
ARENA_ACCESS_TOKEN=

TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=
TURBOPUFFER_NAMESPACE=arena-blocks-v1

# Reserved for V2 only. Do not add an LLM dependency to V1.
OPENAI_API_KEY=
