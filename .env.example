ARENA_ACCESS_TOKEN=

# Comma-separated channel slugs (personal-sites,private-notes,baby-photos). Private channels are always skipped.
ARENA_IGNORE_CHANNELS=

# Vision indexing, on by default (`bun run sync --no-vision` skips it). Only the sync script reads this; it never reaches the Worker.
OPENROUTER_API_KEY=

# Trigger.dev local development
TRIGGER_SECRET_KEY=

# Local public search export (Workers AI Read/Edit API token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hosted maintenance storage (private R2 bucket; token scoped to that bucket only)
MAINTENANCE_R2_BUCKET=
MAINTENANCE_R2_ACCESS_KEY_ID=
MAINTENANCE_R2_SECRET_ACCESS_KEY=

# Optional deployment token for `bun run hosted deploy`; otherwise wrangler login is used
CLOUDFLARE_DEPLOY_API_TOKEN=

# Trigger production only: fine-grained GitHub token (Actions: write on this repository) that dispatches the site deploy
GITHUB_DEPLOY_TOKEN=
