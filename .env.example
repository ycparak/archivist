ARENA_ACCESS_TOKEN=

# Comma-separated channel slugs (personal-sites,private-notes,baby-photos). Private channels are skipped unless allow-listed.
ARENA_IGNORE_CHANNELS=
ARENA_ALLOW_PRIVATE_CHANNELS=

TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=
TURBOPUFFER_NAMESPACE=arena-blocks-v1

# Vision indexing, on by default (`bun run sync --no-vision` skips it). Only the sync script reads this; it never reaches the Worker.
OPENROUTER_API_KEY=
